<?jelly escape-by-default='true'?>
<!-- How often to check, and whether to keep checking, plus the dropdowns shared with the other entry types. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">
  <f:entry title="Check every" field="interval">
    <f:number default="10" min="1"/>
  </f:entry>
  <f:entry title="Time unit" field="unit">
    <f:enum>${it.displayName}</f:enum>
  </f:entry>
  <f:entry title="Repeat" field="repeat">
    <f:booleanRadio true="Keep checking until the build ends" false="Stop after the action has run once"/>
  </f:entry>
  <st:include page="config.jelly" class="io.jenkins.plugins.adaptiveagent.entry.BuildEntry"/>
</j:jelly>

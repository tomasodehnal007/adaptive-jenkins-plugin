<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Reboot command" field="command"
           description="Restarts the whole machine the agent runs on, not just the agent process. Leave empty for the default: 'shutdown -r now' (Linux, macOS) or 'shutdown -r -f -t 0' (Windows). The user running the agent must be allowed to run it.">
    <f:textbox/>
  </f:entry>
</j:jelly>

<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Run when the build result is">
    <!-- A div around each checkbox puts every option on its own line. -->
    <div><f:checkbox title="Success" field="success"/></div>
    <div><f:checkbox title="Failure" field="failure"/></div>
    <div><f:checkbox title="Aborted" field="aborted"/></div>
    <div><f:checkbox title="Unstable" field="unstable"/></div>
    <div><f:checkbox title="Not built" field="notBuilt"/></div>
  </f:entry>
</j:jelly>

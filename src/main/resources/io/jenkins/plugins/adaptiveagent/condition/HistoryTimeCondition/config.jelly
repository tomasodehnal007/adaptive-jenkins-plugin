<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="How many of the latest builds on this agent to average" field="quantity">
    <f:number default="3" min="1"/>
  </f:entry>
  <f:entry title="Average duration is" field="comparison">
    <f:enum>${it.displayName}</f:enum>
  </f:entry>
  <f:entry title="Duration" field="time">
    <f:number default="1" min="0"/>
  </f:entry>
  <f:entry title="Time unit" field="unit">
    <f:enum>${it.displayName}</f:enum>
  </f:entry>
</j:jelly>
